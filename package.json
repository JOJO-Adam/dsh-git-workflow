{
  "name": "@jojonadam/dsh-git-workflow",
  "version": "0.1.1",
  "description": "Git workflow studio for DeepSeek Harness: branch model, commit conventions, PR review, history surgery, disaster recovery and release versioning. 分支纪律 · 提交规范 · 六本手册。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale",
    "README.en.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "workflow",
    "commit",
    "semver",
    "pr-review"
  ],
  "license": "MIT",
  "author": "JOJO & Adam",
  "homepage": "https://jojo-adam.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JOJO-Adam/dsh-git-workflow.git"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/JOJO-Adam/dsh-git-workflow/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon.svg"
}
